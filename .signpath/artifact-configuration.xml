<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration: paste this into the SignPath project
     (Artifact Configurations > default). The GitHub artifact is a zip that
     holds DevJunkCleaner.exe; the exe is Authenticode-signed only when its
     file metadata says it is Dev Junk Cleaner. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="DevJunkCleaner.exe" product-name="Dev Junk Cleaner">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
